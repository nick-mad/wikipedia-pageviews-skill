#!/usr/bin/env bash
# Entry point for the agent: runs the wpv CLI inside the skill's own uv environment.
# First call creates .venv from uv.lock (needs network once); later calls start instantly.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --quiet --frozen --project "$SKILL_DIR" wpv "$@"
